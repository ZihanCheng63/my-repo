#include <stdio.h>
#include <stdlib.h>
#include <stdint.h>
#include <unistd.h>
#include <string.h>
#include <time.h>
#include <fcntl.h>

// ============================================
// 引脚配置（根据你的实际接线修改）
// ============================================
// DHT22 DATA 引脚：A16 -> 系统 GPIO 编号 = 496
#define DHT22_SYSGPIO  496

// LED 引脚：如果外接了 LED 请修改这里，否则用板载 LED
// 板载 LED 的系统 GPIO 编号是 509
#define LED_SYSGPIO    509

// ============================================
// Sysfs GPIO 操作函数
// ============================================

static int gpio_export(int gpio) {
    int fd, len;
    char buf[64];
    fd = open("/sys/class/gpio/export", O_WRONLY);
    if (fd < 0) return -1;
    len = snprintf(buf, sizeof(buf), "%d", gpio);
    write(fd, buf, len);
    close(fd);
    return 0;
}

static int gpio_unexport(int gpio) {
    int fd, len;
    char buf[64];
    fd = open("/sys/class/gpio/unexport", O_WRONLY);
    if (fd < 0) return -1;
    len = snprintf(buf, sizeof(buf), "%d", gpio);
    write(fd, buf, len);
    close(fd);
    return 0;
}

static int gpio_set_dir(int gpio, const char* dir) {
    char path[64];
    snprintf(path, sizeof(path), "/sys/class/gpio/gpio%d/direction", gpio);
    int fd = open(path, O_WRONLY);
    if (fd < 0) return -1;
    write(fd, dir, strlen(dir));
    close(fd);
    return 0;
}

static int gpio_set_value(int gpio, int value) {
    char path[64];
    snprintf(path, sizeof(path), "/sys/class/gpio/gpio%d/value", gpio);
    int fd = open(path, O_WRONLY);
    if (fd < 0) return -1;
    if (value)
        write(fd, "1", 1);
    else
        write(fd, "0", 1);
    close(fd);
    return 0;
}

static int gpio_get_value(int gpio) {
    char path[64];
    char buf;
    snprintf(path, sizeof(path), "/sys/class/gpio/gpio%d/value", gpio);
    int fd = open(path, O_RDONLY);
    if (fd < 0) return -1;
    read(fd, &buf, 1);
    close(fd);
    return (buf == '1') ? 1 : 0;
}

void delayMicroseconds(int us) {
    usleep(us);
}

// ============================================
// DHT22 读取函数
// ============================================

int read_dht22(int data_gpio, float *temperature, float *humidity) {
    uint8_t data[5] = {0};
    
    // 1. 发送起始信号
    gpio_set_dir(data_gpio, "out");
    gpio_set_value(data_gpio, 1);
    delayMicroseconds(500000);  // 500ms
    gpio_set_value(data_gpio, 0);
    delayMicroseconds(20000);   // 20ms
    gpio_set_dir(data_gpio, "in");
    
    // 2. 等待 DHT22 响应
    int timeout = 0;
    while(gpio_get_value(data_gpio) == 1 && timeout < 1000) {
        delayMicroseconds(1);
        timeout++;
    }
    if(timeout >= 1000) return 0;
    
    while(gpio_get_value(data_gpio) == 0 && timeout < 1000) {
        delayMicroseconds(1);
        timeout++;
    }
    if(timeout >= 1000) return 0;
    
    while(gpio_get_value(data_gpio) == 1 && timeout < 1000) {
        delayMicroseconds(1);
        timeout++;
    }
    if(timeout >= 1000) return 0;
    
    // 3. 读取 40 位数据
    for(int i = 0; i < 40; i++) {
        while(gpio_get_value(data_gpio) == 0);
        
        int duration = 0;
        while(gpio_get_value(data_gpio) == 1 && duration < 100) {
            delayMicroseconds(1);
            duration++;
        }
        
        if(duration > 30) {
            data[i/8] |= (1 << (7 - (i % 8)));
        }
    }
    
    // 4. 校验数据
    if(data[4] == ((data[0] + data[1] + data[2] + data[3]) & 0xFF)) {
        *humidity = (data[0] * 256 + data[1]) / 10.0;
        *temperature = ((data[2] & 0x7F) * 256 + data[3]) / 10.0;
        if(data[2] & 0x80) *temperature *= -1;
        return 1;
    }
    
    return 0;
}

// ============================================
// 主函数
// ============================================

int main() {
    // 导出 GPIO
    gpio_export(DHT22_SYSGPIO);
    gpio_export(LED_SYSGPIO);
    usleep(100000);  // 等待系统处理
    
    // 设置 LED 为输出，初始低电平
    gpio_set_dir(LED_SYSGPIO, "out");
    gpio_set_value(LED_SYSGPIO, 0);
    
    printf("\n========================================\n");
    printf("  DHT22 温湿度传感器 + LED 控制\n");
    printf("  DATA 引脚: A16 (系统 GPIO %d)\n", DHT22_SYSGPIO);
    printf("  温度 > 30°C 时 LED 点亮\n");
    printf("  按 Ctrl+C 退出\n");
    printf("========================================\n\n");
    
    float temp, humi;
    
    while(1) {
        if(read_dht22(DHT22_SYSGPIO, &temp, &humi)) {
            time_t now = time(NULL);
            struct tm *tm_info = localtime(&now);
            
            if(temp > 30.0) {
                gpio_set_value(LED_SYSGPIO, 1);
                printf("[%02d:%02d:%02d] ✓ 温度:%.1f°C 湿度:%.1f%% → LED 亮\n",
                       tm_info->tm_hour, tm_info->tm_min, tm_info->tm_sec, temp, humi);
            } else {
                gpio_set_value(LED_SYSGPIO, 0);
                printf("[%02d:%02d:%02d] ✓ 温度:%.1f°C 湿度:%.1f%% → LED 灭\n",
                       tm_info->tm_hour, tm_info->tm_min, tm_info->tm_sec, temp, humi);
            }
        } else {
            printf("读取失败，检查 DHT22 接线和上拉电阻\n");
        }
        
        delayMicroseconds(2000000);  // 2秒
    }
    
    return 0;
}
